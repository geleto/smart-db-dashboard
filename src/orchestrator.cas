// Fetch each card's data, then build its content.
function processElement(element)
	element.id = normalizeElementId(element)
	var rows = []
	if element.usesData and element.dataRequest
		// Narrow the schema: scope the summary to just this card's tables
		element.schemaSummary = schemaSummaryTemplate(schemaMetadataForTables(element.requiredTables))
		// Fetch the data: the LLM drafts the SQL, the database runs it
		var sql = sqlFromRequestGenerator(element).text
		var queryResult = database.executeSql(sql, element.type)
		var repairAttempts = 0
		// Repair and fall back: retry a failed/empty query, escalating the model then widening the schema
		while repairAttempts < 2 and (queryResult is error or queryResult.length == 0)
			repairAttempts = repairAttempts + 1
			if repairAttempts == 2
				element.schemaSummary = fullSchemaSummary
			endif
			sql = sqlRepairGenerator({
				element: element,
				previousSql: sql,
				failureReason: queryResult#description if queryResult is error else "The query returned zero rows.",
				repairAttempt: repairAttempts
			}).text
			queryResult = database.executeSql(sql, element.type)
		endwhile
		// Give up gracefully: the page will show an error card.
		if queryResult is error or queryResult.length == 0
			element.queryError = queryResult#description if queryResult is error else "The query returned zero rows."
			return element
		endif
		rows = queryResult
	endif
	// Metrics use shared markup; insights already produce HTML.
	if element.type == "metric"
		element.metric = rows[0]
	elif element.type == "insight"
		element.previewJson = generatePreviewJson(rows, 25)
		element.contentHtml = textInsightGenerator(element).text
	else
		if element.usesData
			element.previewJson = generatePreviewJson(rows)
		endif
		var renderedElement = elementRenderer({ element: element }).object
		element.html = renderedElement.html
		element.script = renderedElement.script.trim()
		// Only generated scripts need browser-side rows.
		if element.script and element.usesData
			element.dataJson = toJson(element.id) ~ ": " ~ toJson(rows)
		endif
	endif
	return element
endfunction

// Plan the layout: three planners run in parallel and stream cards as they decide them
var headerMetrics = headerMetricPlanner({ fullSchemaSummary: fullSchemaSummary }).elementStream
var chartsTables = visualPlanner({ fullSchemaSummary: fullSchemaSummary }).elementStream
var insightsText = insightTextPlanner({ fullSchemaSummary: fullSchemaSummary }).elementStream

// Process each card as it streams, without waiting for the full plan.
data processedElements = []
for section in [headerMetrics, chartsTables, insightsText]
	for element in section
		processedElements.push(processElement(element))
	endfor
endfor
return processedElements.snapshot()
